# Copy required values into /etc/job-alert-system.env on the server.
# Do not commit the real file.

# Optional: one HTTP/HTTPS forward proxy. Credentials, if needed, remain here.
# JOB_ALERT_PROXY_URL=http://USERNAME:PASSWORD@HOST:PORT
# Or store {"proxy_url": "..."} in a root-owned, mode-600 JSON file:
# JOB_ALERT_PROXY_FILE=/etc/job-alert-system-proxy.json

# Optional outbound-request bounds (defaults shown).
# JOB_ALERT_MAX_WORKERS=10
# JOB_ALERT_PER_DOMAIN_CONCURRENCY=2
